APP_NAME="toefl-go"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---------------------------------------------------------------
# Database: NeonDB (PostgreSQL)
# Pakai host pooled (berakhiran -pooler) untuk aplikasi.
# Untuk `php artisan migrate`, boleh pakai host direct (tanpa -pooler)
# kalau migrasi bermasalah lewat pooler.
# ---------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=ep-xxxx-xxxx-pooler.ap-southeast-1.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=
DB_SSLMODE=require

# Uji lokal tanpa Neon: ganti blok di atas dengan dua baris ini
# (lalu `touch database/database.sqlite`):
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# Session/cache pakai file supaya tidak menambah query ke Neon di tiap request
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ---------------------------------------------------------------
# AI tutor (Gemini). Kosongkan kalau belum punya key: app tetap jalan penuh.
# Key hanya dibaca server, tidak pernah dikirim ke browser.
# ---------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
TUTOR_PER_MINUTE=6
TUTOR_PER_DAY=100

VITE_APP_NAME="${APP_NAME}"
